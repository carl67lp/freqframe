# Build stage
FROM node:22-alpine AS builder

WORKDIR /build

# Copy monorepo files
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY nx.json ./

# Copy apps
COPY apps/freqframe-ui ./apps/freqframe-ui
COPY shared-types ./shared-types

# Install dependencies
RUN npm ci

# Build UI for production
RUN npm run build -- freqframe-ui --prod

# Runtime stage - use nginx to serve static files
FROM nginx:alpine

# Copy built app
COPY --from=builder /build/dist/apps/freqframe-ui/browser /usr/share/nginx/html

# Copy nginx config for UI (simple HTTP, no SSL)
COPY nginx-ui.conf /etc/nginx/nginx.conf

EXPOSE 4200

CMD ["nginx", "-g", "daemon off;"]
