# CalDAV credentials
CALDAV_USERNAME=your-username
CALDAV_PASSWORD=your-password

# Shared secret required by the X-Api-Key header on /api/calendars/*.
# Must match apiKey in the UI's environment.prod.ts. Required — the API
# rejects every request when it is unset. Use a strong random string.
API_KEY=change-me-in-production

# Cloud 9 chore board, read server-side by the dashboard's chore pane.
# Leave unset to hide the pane's data (it renders "unavailable" rather than
# fabricating a $0.00 month). Point at the host:port the Cloud 9 stack
# publishes, or at the container name if both stacks share a Docker network.
CLOUD9_BASE_URL=http://192.168.1.100:5000
